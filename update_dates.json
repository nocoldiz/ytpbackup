#!/usr/bin/env python3
import os
import re
from pathlib import Path
from bs4 import BeautifulSoup
import argparse

# Import VideoIndex and defaults from your existing script
try:
    from yt_downloader import VideoIndex, DEFAULT_SITE_DIR, DEFAULT_VIDEO_DIR
except ImportError:
    print("Error: Could not find yt_downloader.py in the current directory.")
    exit(1)

def extract_first_post_date(html_content):
    """
    Finds the first 'Inviato il:' in the HTML and extracts the date string after it.
    Example: <b>Inviato il:</b> 27/10/2008, 20:12
    """
    soup = BeautifulSoup(html_content, "lxml")
    
    # Find the bold tag containing 'Inviato il:'
    target_b = soup.find("b", string=re.compile(r"Inviato il:", re.I))
    
    if target_b:
        # The date is usually the text immediately following the <b> tag within the same parent
        parent_text = target_b.parent.get_text(strip=True)
        if "Inviato il:" in parent_text:
            # Split and take the part after 'Inviato il:'
            date_part = parent_text.split("Inviato il:")[1].strip()
            return date_part
            
    # Fallback: search for the raw text if <b> tags are structured differently
    match = re.search(r"Inviato il:\s*([^<]+)", html_content, re.I)
    if match:
        return match.group(1).strip()
        
    return None

def main():
    parser = argparse.ArgumentParser(description="Update video_index with post dates from forum pages.")
    parser.add_argument("--site-dir", default=DEFAULT_SITE_DIR, help="Directory with mirrored HTML files")
    parser.add_argument("--video-dir", default=DEFAULT_VIDEO_DIR, help="Directory with video_index.json")
    args = parser.parse_args()

    # Initialize and load the existing index
    index = VideoIndex(args.video_dir)
    index.load()

    print(f"Loaded index with {len(index.data)} videos.")
    updated_count = 0
    missing_files = 0
    
    for vid, data in index.data.items():
        # Optional: Skip if post_date is already present
        # if data.get("post_date"): continue
            
        source_pages = data.get("source_pages", [])
        if not source_pages:
            continue
            
        # We check the first source page listed for this video
        first_page_rel = source_pages[0]
        full_path = os.path.join(args.site_dir, first_page_rel)
        
        if not os.path.exists(full_path):
            missing_files += 1
            continue
            
        try:
            with open(full_path, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
                
            post_date = extract_first_post_date(content)
            if post_date:
                # Add the new field to the video entry
                data["post_date"] = post_date
                updated_count += 1
                
                if updated_count % 100 == 0:
                    print(f"  Processed {updated_count} videos...")
        except Exception as e:
            print(f"  [!] Error processing {first_page_rel}: {e}")

    # Save the updated index back to video_index.json
    index.save()
    
    print("\n" + "="*30)
    print(f"Update complete.")
    print(f"Videos updated with post_date: {updated_count}")
    if missing_files:
        print(f"Source files not found: {missing_files}")
    print(f"Index saved to: {os.path.abspath(index.filepath)}")

if __name__ == "__main__":
    main()